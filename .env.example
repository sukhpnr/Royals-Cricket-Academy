# Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# Supabase Database Configuration
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.jwkhdzzfotbmiwjsczdm.supabase.co:5432/postgres

# API Server Configuration
API_PORT=5000
NODE_ENV=development

# Supabase Public URL (for frontend)
NEXT_PUBLIC_SUPABASE_URL=https://jwkhdzzfotbmiwjsczdm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# JWT Configuration (if using auth)
JWT_SECRET=your_jwt_secret_here

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
